# restto client 环境变量（复制为 .env 后按需修改）
MANAGER_HOST=127.0.0.1
MANAGER_PORT=9600
NODE_NAME=default-node
NODE_TOKEN=replace-with-real-node-token
CLIENT_VERSION=0.1.0
LOG_DIR=logs
DATA_DIR=data
HEARTBEAT_INTERVAL_SECS=15
LOG_LEVEL=info
# 可选：CLI 额外查找目录（runner 优先级：$DATA_DIR/clis → bin/clis → 此变量 → PATH）
RESTTO_CLIS_DIR=
